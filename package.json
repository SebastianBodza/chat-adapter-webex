{
  "name": "@bitbasti/chat-adapter-webex",
  "version": "0.1.0",
  "description": "Webex adapter for Chat SDK",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --coverage",
    "test:unit": "vitest run src",
    "test:integration": "vitest run test/integration",
    "test:watch": "vitest",
    "check:package": "publint --strict",
    "ci": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:package",
    "clean": "rimraf dist coverage"
  },
  "dependencies": {
    "@chat-adapter/shared": "^4.15.0"
  },
  "peerDependencies": {
    "chat": "^4.15.0"
  },
  "devDependencies": {
    "@chat-adapter/state-memory": "^4.45.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^5.1.1",
    "chat": "^4.15.0",
    "eslint": "^10.15.0",
    "publint": "^0.3.25",
    "rimraf": "^6.1.4",
    "semver": "^7.8.6",
    "tsup": "^9.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SebastianBodza/chat-adapter-webex.git"
  },
  "homepage": "https://github.com/SebastianBodza/chat-adapter-webex#readme",
  "bugs": {
    "url": "https://github.com/SebastianBodza/chat-adapter-webex/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "chat-sdk",
    "chat-adapter",
    "webex"
  ],
  "license": "MIT"
}
